#Режим,Назва,    Що робить?,   Увага! ⚠️
#'r',  Read,     Тільки читає.,"Помилка, якщо файлу не існує."
#'w',  Write,    Тільки пише., "Стирає все, що було у файлі! Створює новий, якщо немає."
#'a',  Append,   Дописує.,     Додає дані в кінець файлу. Не чіпає старі дані.
#'x',  eXclusive,Створення.,   "Створює файл, але видає помилку, якщо він вже є (безпечніше за 'w')."

import json  # Підключаємо бібліотеку для роботи з форматом JSON

# ==========================================
# ЧАСТИНА 1: ЗАПИС ДАНИХ (Serialization)
# ==========================================

# Наші дані в Python (словник)
settings = {
    "app_name": "SiteMonitor",
    "version": 1.0,
    "is_active": True,       # В JSON це стане true (маленькими)
    "admin_email": None,     # В JSON це стане null
    "sites": ["google.com", "prom.ua"]
}

# 1. Відкриваємо файл для запису ('w')
# encoding='utf-8' ОБОВ'ЯЗКОВО для кирилиці 
with open("config.json", "w", encoding="utf-8") as file:
    
    # json.dump() — це функція "скидання" даних у файл
    # ensure_ascii=False — дозволяє записувати укр. літери як є, а не кодами \u043
    # indent=4 — робить красиві відступи (структуру), щоб людині було зручно читати
    json.dump(settings, file, ensure_ascii=False, indent=4)

print("✅ Файл config.json успішно створено!")


# ==========================================
# ЧАСТИНА 2: ЩО БУДЕ ПРИ ІНШИХ РЕЖИМАХ?
# ==========================================

# Спробуємо режим 'a' (Append - дописування)
log_entry = "Error: Site offline\n"

with open("logs.txt", "a", encoding="utf-8") as f:
    f.write(log_entry)
    # Якби тут стояло 'w', старі логи стиралися б при кожному запуску!
    # А 'a' дбайливо додає новий рядок у кінець.


# ==========================================
# ЧАСТИНА 3: ЧИТАННЯ ДАНИХ (Deserialization)
# ==========================================

try:
    # Відкриваємо файл ТІЛЬКИ для читання ('r')
    with open("config.json", "r", encoding="utf-8") as file:
        
        # json.load() — зчитує файл і перетворює його назад у словник Python
        data_from_file = json.load(file)
        
        print(f"\n📥 Прочитано з файлу:")
        print(f"Тип даних: {type(data_from_file)}") # <class 'dict'>
        print(f"Адмін: {data_from_file['admin_email']}") # Виведе: None (а не null)

except FileNotFoundError:
    # Цей блок спрацює, якщо ми спробуємо відкрити неіснуючий файл у режимі 'r'
    print("❌ Помилка: Файл не знайдено. Спершу запустіть запис!")

except json.JSONDecodeError:
    # Спрацює, якщо файл є, але всередині "сміття", а не валідний JSON
    print("❌ Помилка: Файл пошкоджено.")